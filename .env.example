# Connection string de Supabase (Settings → Database → Connection string → URI)
# Usa el pooler (Transaction) para Vercel/serverless, o Session para drizzle-kit push local.
DATABASE_URL=postgresql://postgres.xxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Clave para entrar al modo administrador desde la pantalla inicial
ADMIN_PASSWORD=admin123

# Secreto de cookie firmada (mínimo 32 caracteres). No es JWT.
SESSION_SECRET=cambia-este-secreto-de-sesion-32ch
